NODE_ENV=development
PORT=3000

# --- Base de datos ---
# Opcion A (local): variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=LaPortenia2
DB_USER=portenia_app
DB_PASSWORD=changeme
DB_DIALECT=postgres

# Opcion B (produccion): connection string unica. Si esta definida, tiene prioridad
# sobre las variables de arriba. Es lo que entregan Neon, Render, Supabase y Railway.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Los Postgres manejados exigen SSL. Poner en true al deployar.
DB_SSL=false

# --- Autenticacion ---
# Generar uno nuevo con: openssl rand -hex 64
JWT_SECRET=changeme-generate-a-random-64-char-string
JWT_EXPIRES_IN=8h

# --- CORS ---
# En produccion: la URL exacta del frontend, sin barra final.
CORS_ORIGIN=http://localhost:9000
